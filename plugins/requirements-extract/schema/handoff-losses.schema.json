{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "generationId": {
      "type": "string",
      "pattern": "^[a-f0-9-]{36}$"
    },
    "documentRevision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/loss"
      }
    }
  },
  "required": [
    "schemaVersion",
    "generationId",
    "documentRevision",
    "items"
  ],
  "additionalProperties": false,
  "$defs": {
    "target": {
      "type": "object",
      "properties": {
        "path": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "documentRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bindingState": {
          "enum": [
            "current",
            "uncertain",
            "deleted",
            "no-source"
          ]
        },
        "selector": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "block"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "list-item"
                },
                "index": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "kind",
                "index"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "cell"
                },
                "row": {
                  "type": "integer",
                  "minimum": 0
                },
                "column": {
                  "type": "integer",
                  "minimum": 0
                },
                "rowSpan": {
                  "type": "integer",
                  "minimum": 1
                },
                "columnSpan": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "kind",
                "row",
                "column",
                "rowSpan",
                "columnSpan"
              ],
              "additionalProperties": false
            }
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "enum": [
            "content",
            "explanation"
          ]
        }
      },
      "required": [
        "path",
        "documentRevision",
        "bindingState",
        "selector",
        "text",
        "role"
      ],
      "additionalProperties": false
    },
    "loss": {
      "type": "object",
      "properties": {
        "sourceId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reasonCode": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "blocking",
            "advisory"
          ]
        },
        "resolution": {
          "const": "unreviewed"
        },
        "originalValue": {},
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target"
          }
        },
        "category": {
          "enum": [
            "native-format",
            "authoring-input",
            "plugin-pending"
          ]
        }
      },
      "required": [
        "sourceId",
        "reasonCode",
        "severity",
        "resolution",
        "originalValue",
        "targets",
        "category"
      ],
      "additionalProperties": false
    }
  }
}
