{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.3.0"
    },
    "generationId": {
      "type": "string",
      "pattern": "^[a-f0-9-]{36}$"
    },
    "status": {
      "const": "generated"
    },
    "reviewState": {
      "enum": [
        "unreviewed",
        "reviewed"
      ]
    },
    "documentRevision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "files": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "relativePath": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:\\x00])[A-Za-z0-9._/-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "relativePath",
          "sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "generationId",
    "status",
    "reviewState",
    "documentRevision",
    "files"
  ],
  "additionalProperties": false
}
