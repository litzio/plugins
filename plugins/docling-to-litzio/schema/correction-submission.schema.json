{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:litzio:docling-to-litzio:correction-submission:1.1",
  "type": "object",
  "properties": {
    "changeId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9-]{1,80}$"
    },
    "generationId": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "groupId": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "enum": [
        "assistant",
        "human"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": [
        "correct",
        "uncertain"
      ]
    },
    "target": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "paragraph",
            "cell",
            "equation"
          ]
        },
        "path": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "row": {
          "type": "integer",
          "minimum": 0
        },
        "column": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "kind",
        "path"
      ],
      "additionalProperties": false
    },
    "before": {
      "type": "string"
    },
    "after": {
      "type": "string"
    },
    "evidence": {
      "type": "object",
      "properties": {
        "refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "pageNo": {
                "type": "integer",
                "minimum": 1
              },
              "bbox": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number"
                }
              }
            },
            "required": [
              "pageNo",
              "bbox"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "refs",
        "scope"
      ],
      "additionalProperties": false
    },
    "undoOf": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "changeId",
    "generationId",
    "revision",
    "groupId",
    "actor",
    "reason",
    "decision"
  ],
  "additionalProperties": false
}
