{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:litzio:docling-to-litzio:correction-history:1.2",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "enum": [
        "1.1.0",
        "1.2.0"
      ]
    },
    "generationId": {
      "type": "string",
      "minLength": 1
    },
    "baselineRevision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "changeId": {
            "type": "string",
            "minLength": 1
          },
          "groupId": {
            "type": "string",
            "minLength": 1
          },
          "actor": {
            "enum": [
              "assistant",
              "human"
            ]
          },
          "time": {
            "type": "string",
            "minLength": 1
          },
          "sourceHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "beforeRevision": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "afterRevision": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "target": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "paragraph",
                  "cell",
                  "equation"
                ]
              },
              "path": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "row": {
                "type": "integer",
                "minimum": 0
              },
              "column": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "kind",
              "path"
            ],
            "additionalProperties": false
          },
          "before": {
            "type": "string"
          },
          "after": {
            "type": "string"
          },
          "evidence": {
            "type": "object",
            "properties": {
              "refs": {
                "type": "array",
                "minItems": 0,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "scope": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "pageNo": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "bbox": {
                      "type": "array",
                      "minItems": 4,
                      "maxItems": 4,
                      "items": {
                        "type": "number"
                      }
                    }
                  },
                  "required": [
                    "pageNo",
                    "bbox"
                  ],
                  "additionalProperties": false
                }
              },
              "kind": {
                "enum": [
                  "pdf-tokens",
                  "human-source-region"
                ]
              }
            },
            "required": [
              "refs",
              "scope"
            ],
            "additionalProperties": false
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "receipt": {
            "type": "object",
            "properties": {
              "ok": {
                "const": true
              },
              "command": {
                "const": "apply-batch"
              },
              "applied": {
                "const": 1
              },
              "revision": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "ok",
              "command",
              "applied",
              "revision"
            ],
            "additionalProperties": false
          },
          "undoOf": {
            "type": [
              "string",
              "null"
            ]
          },
          "validation": {
            "type": "object",
            "properties": {
              "readback": {
                "const": true
              },
              "protectedTokens": {
                "type": "boolean"
              },
              "evidenceRecheck": {
                "enum": [
                  "verified-protected-tokens",
                  "not-applicable",
                  "undo-restoration",
                  "human-source-region"
                ]
              }
            },
            "required": [
              "readback",
              "protectedTokens",
              "evidenceRecheck"
            ],
            "additionalProperties": false
          },
          "inverse": {
            "type": "object"
          },
          "beforeContent": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "afterContent": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "changeId",
          "groupId",
          "actor",
          "time",
          "sourceHash",
          "beforeRevision",
          "afterRevision",
          "target",
          "before",
          "after",
          "evidence",
          "reason",
          "receipt",
          "undoOf",
          "validation",
          "inverse"
        ],
        "additionalProperties": false
      }
    },
    "currentSnapshot": {
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "generationId",
    "baselineRevision",
    "changes",
    "currentSnapshot"
  ],
  "additionalProperties": false
}
