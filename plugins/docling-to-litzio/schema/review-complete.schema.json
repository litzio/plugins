{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "generationId": {
      "type": "string"
    },
    "documentRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reportSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidenceSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "const": "generated-unreviewed"
    }
  },
  "required": [
    "schemaVersion",
    "generationId",
    "documentRevision",
    "reportSha256",
    "evidenceSha256",
    "status"
  ],
  "additionalProperties": false
}
