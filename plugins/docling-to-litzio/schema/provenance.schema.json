{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:litzio:docling-to-litzio:provenance:1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "generationId": {
      "type": "string",
      "pattern": "^[a-f0-9-]{36}$"
    },
    "generatorVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "rulesVersion": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^\\d+\\.\\d+\\.\\d+$"
      }
    },
    "reviewState": {
      "const": "unreviewed"
    },
    "source": {
      "type": "object",
      "properties": {
        "pdf": {
          "type": "object",
          "properties": {
            "relativePath": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:\\x00])[A-Za-z0-9._/-]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "relativePath",
            "sha256"
          ],
          "additionalProperties": false
        },
        "docling": {
          "type": "object",
          "properties": {
            "relativePath": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:\\x00])[A-Za-z0-9._/-]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "relativePath",
            "sha256"
          ],
          "additionalProperties": false
        },
        "conversionRecord": {
          "type": "object",
          "properties": {
            "relativePath": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:\\x00])[A-Za-z0-9._/-]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "relativePath",
            "sha256"
          ],
          "additionalProperties": false
        },
        "documentSchemaVersion": {
          "const": "1.10.0"
        }
      },
      "required": [
        "pdf",
        "docling",
        "conversionRecord",
        "documentSchemaVersion"
      ],
      "additionalProperties": false
    },
    "document": {
      "type": "object",
      "properties": {
        "relativePath": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:\\x00])[A-Za-z0-9._/-]+$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "kind": {
                "type": "string"
              },
              "text": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "path",
              "kind",
              "text"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "relativePath",
        "revision",
        "blocks"
      ],
      "additionalProperties": false
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pageNo": {
            "type": "integer",
            "minimum": 1
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "height": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "rotation": {
            "type": [
              "number",
              "null"
            ]
          },
          "printedLabel": {
            "type": [
              "string",
              "null"
            ]
          },
          "unit": {
            "const": "pt"
          },
          "origin": {
            "const": "TOPLEFT"
          }
        },
        "required": [
          "pageNo",
          "width",
          "height",
          "rotation",
          "printedLabel",
          "unit",
          "origin"
        ],
        "additionalProperties": false
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "relativePath": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:\\x00])[A-Za-z0-9._/-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "required": [
          "relativePath",
          "sha256",
          "sourceIds"
        ],
        "additionalProperties": false
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "schemaVersion",
    "generationId",
    "generatorVersion",
    "rulesVersion",
    "reviewState",
    "source",
    "document",
    "pages",
    "items",
    "assets",
    "diagnostics"
  ],
  "additionalProperties": false,
  "$defs": {
    "target": {
      "type": "object",
      "properties": {
        "path": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "documentRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bindingState": {
          "enum": [
            "current",
            "uncertain",
            "deleted",
            "no-source"
          ]
        },
        "selector": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "block"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "list-item"
                },
                "index": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "kind",
                "index"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "cell"
                },
                "row": {
                  "type": "integer",
                  "minimum": 0
                },
                "column": {
                  "type": "integer",
                  "minimum": 0
                },
                "rowSpan": {
                  "type": "integer",
                  "minimum": 1
                },
                "columnSpan": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "kind",
                "row",
                "column",
                "rowSpan",
                "columnSpan"
              ],
              "additionalProperties": false
            }
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "enum": [
            "content",
            "explanation"
          ]
        }
      },
      "required": [
        "path",
        "documentRevision",
        "bindingState",
        "selector",
        "text",
        "role"
      ],
      "additionalProperties": false
    },
    "region": {
      "type": "object",
      "properties": {
        "pageNo": {
          "type": "integer",
          "minimum": 1
        },
        "bbox": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number"
          }
        },
        "unit": {
          "const": "pt"
        },
        "origin": {
          "const": "TOPLEFT"
        },
        "original": {
          "type": "object"
        }
      },
      "required": [
        "pageNo",
        "bbox",
        "unit",
        "origin",
        "original"
      ],
      "additionalProperties": false
    },
    "cell": {
      "type": "object",
      "properties": {
        "sourceId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "cellIndex": {
          "type": "integer",
          "minimum": 0
        },
        "sourceCell": {
          "type": "object"
        },
        "regionPrecision": {
          "const": "table"
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target"
          }
        }
      },
      "required": [
        "sourceId",
        "cellIndex",
        "sourceCell",
        "regionPrecision",
        "targets"
      ],
      "additionalProperties": false
    },
    "loss": {
      "type": "object",
      "properties": {
        "sourceId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reasonCode": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "blocking",
            "advisory"
          ]
        },
        "resolution": {
          "const": "unreviewed"
        },
        "originalValue": {},
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target"
          }
        },
        "category": {
          "enum": [
            "native-format",
            "authoring-input",
            "plugin-pending"
          ]
        }
      },
      "required": [
        "sourceId",
        "reasonCode",
        "severity",
        "resolution",
        "originalValue",
        "targets",
        "category"
      ],
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "properties": {
        "sourceId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "selfRef": {
          "type": "string",
          "pattern": "^#/"
        },
        "label": {
          "type": "string"
        },
        "sourceText": {
          "type": [
            "string",
            "null"
          ]
        },
        "originalText": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewState": {
          "const": "unreviewed"
        },
        "regions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/region"
          }
        },
        "disposition": {
          "enum": [
            "mapped",
            "container",
            "furniture",
            "omitted",
            "unsupported"
          ]
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target"
          }
        },
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cell"
          }
        },
        "losses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/loss"
          }
        },
        "structure": {
          "type": "object"
        }
      },
      "required": [
        "sourceId",
        "selfRef",
        "label",
        "sourceText",
        "originalText",
        "reviewState",
        "regions",
        "disposition",
        "targets",
        "cells",
        "losses",
        "structure"
      ],
      "additionalProperties": false
    }
  }
}
