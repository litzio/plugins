  "healthCheck": "health",
  "settingsSchema": {
    "type": "object",
    "properties": {
      "workspaceDirectory": {
        "type": "string",
        "title": "작업 폴더",
        "description": "입력 묶음과 새 generation을 담을 Host의 절대 폴더. 열린 폴더 목록과 별개입니다."
      },
      "cliEntry": {
        "type": "string",
        "title": "공식 CLI 진입 파일",
        "description": "이 Host에서 실행할 소스 빌드 cli.mjs 절대 경로. 설치된 CLI를 자동 탐색하지 않습니다."
      }
    },
    "additionalProperties": false
  }
