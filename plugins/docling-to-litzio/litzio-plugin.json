{
  "id": "local.docling-to-litzio",
  "name": "Docling 문서 만들기",
  "description": "고정 변환 결과에서 리치오 문서와 검수 대상 목록을 만듭니다. 생성 결과는 검수 전 초안입니다.",
  "icon": "FileText",
  "entry": "host.mjs",
  "screen": "screen.jsx",
  "operations": [
    {
      "id": "health",
      "version": 1,
      "effect": "read",
      "scope": "host",
      "assistant": true,
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "ok",
          "message"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "preflight",
      "version": 1,
      "effect": "read",
      "scope": "host",
      "assistant": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "bundle": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "bundle"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "bundle": {
            "type": "string"
          },
          "fingerprint": {
            "type": "string"
          },
          "sourceName": {
            "type": "string"
          },
          "pages": {
            "type": "integer",
            "minimum": 0
          },
          "schemaVersion": {
            "type": "string"
          },
          "pictures": {
            "type": "integer",
            "minimum": 0
          },
          "diagnostics": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "supported": {
            "type": "boolean"
          }
        },
        "required": [
          "bundle",
          "fingerprint",
          "sourceName",
          "pages",
          "schemaVersion",
          "pictures",
          "diagnostics",
          "supported"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "start",
      "version": 1,
      "effect": "write",
      "scope": "host",
      "assistant": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "bundle": {
            "type": "string"
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "requestId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        },
        "required": [
          "bundle",
          "fingerprint",
          "requestId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "bundle": {
            "type": "string"
          },
          "fingerprint": {
            "type": "string"
          },
          "output": {
            "type": "string"
          },
          "phase": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "jobId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "state": {
            "enum": [
              "queued",
              "running",
              "ready",
              "failed",
              "interrupted"
            ]
          },
          "errorCode": {
            "type": "string"
          }
        },
        "required": [
          "bundle",
          "fingerprint",
          "output",
          "phase",
          "message",
          "createdAt",
          "updatedAt",
          "jobId",
          "state"
        ],
        "additionalProperties": false
      }
    },
